datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  // Resuelve los include anidados en una sola consulta SQL (JOIN LATERAL) en vez de una por relación.
  // Con la base de datos lejos (Neon), cada viaje cuesta ~60 ms y esto reduce los viajes drásticamente.
  previewFeatures = ["relationJoins"]
}

// -------------------------------------------------------------
// MODELOS DE AUTENTICACIÓN (Auth.js / NextAuth)
// -------------------------------------------------------------
model User {
  id             String    @id @default(cuid())
  name           String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  bio            String?
  accounts       Account[]
  sessions       Session[]
  favoriteTeamId String?
  favoriteTeam   Team?     @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)
  role           UserRole  @default(USER)

  reviews     Review[]
  mvpVotes    MvpVote[]
  watchlist   Watchlist[]
  matchLogs   MatchLog[]
  reviewLikes ReviewLike[]
  comments    ReviewComment[]
  reports     Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -------------------------------------------------------------
// COMPETICIONES & EQUIPOS
// -------------------------------------------------------------
model Competition {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?
  type    String
  apiId   Int?    @unique // id de la liga en API-Football
  matches Match[]

  seasons   CompetitionSeason[]
  standings Standing[]

  @@map("competitions")
}

// Control del sync diario: qué partes de cada temporada ya se descargaron
model CompetitionSeason {
  id                String      @id @default(cuid())
  competitionId     String
  competition       Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season            String // "2024-2025", como Match.season
  apiSeason         Int // 2024, como lo pide la API
  fixturesSyncedAt  DateTime?
  teamsSyncedAt     DateTime?
  standingsSyncedAt DateTime?

  @@unique([competitionId, season])
  @@map("competition_seasons")
}

// Tabla de posiciones. En temporadas con grupos hay una tabla por grupo
model Standing {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season        String
  groupName     String      @default("")
  rank          Int
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points        Int
  played        Int
  win           Int
  draw          Int
  lose          Int
  goalsFor      Int
  goalsAgainst  Int
  goalsDiff     Int
  form          String? // "LWWWW": últimos resultados, el más reciente PRIMERO (así lo manda la API)
  description   String? // Lo que significa el puesto según la API (clasificación, playoff...)

  @@unique([competitionId, season, groupName, teamId])
  @@map("standings")
}

model Team {
  id            String  @id @default(cuid())
  name          String
  shortName     String?
  slug          String  @unique
  crestUrl      String?
  country       String?
  apiId         Int?    @unique
  founded       Int?
  venueName     String?
  venueCity     String?
  venueCapacity Int?
  venueImageUrl String?

  homeMatches  Match[]          @relation("HomeTeam")
  awayMatches  Match[]          @relation("AwayTeam")
  players      Player[]
  fans         User[]           @relation("FavoriteTeam")
  matchEvents  MatchEvent[]
  matchStats   MatchTeamStats[]
  lineups      MatchLineup[]
  matchPlayers MatchPlayer[]
  standings    Standing[]

  @@map("teams")
}

model Player {
  id       String  @id @default(cuid())
  name     String
  photoUrl String?
  position String?
  teamId   String?
  number   Int?

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  mvpVotes   MvpVote[]
  matchStats MatchPlayer[]
  career     PlayerCareerTeam[]

  // Cuándo se descargó su trayectoria (/players/teams); null = pendiente
  careerSyncedAt DateTime?

  @@map("players")
}

// -------------------------------------------------------------
// PARTIDOS (MATCHES)
// -------------------------------------------------------------
model Match {
  id        String   @id @default(cuid())
  apiId     Int?     @unique // id del partido (fixture) en API-Football
  date      DateTime
  homeScore Int
  awayScore Int
  stadium   String?
  stage     String?
  season    String
  isIconic  Boolean  @default(false)
  summary   String?  @db.Text
  tags      String[]

  // Detalle completo (sync diario): null mientras no se haya descargado
  referee         String?
  homeHalfScore   Int?
  awayHalfScore   Int?
  homePenalties   Int? // tanda de penales, si la hubo
  awayPenalties   Int?
  detailsSyncedAt DateTime?

  homeTeamId String
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId String
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  reviews   Review[]
  mvpVotes  MvpVote[]
  watchlist Watchlist[]
  logs      MatchLog[]
  events    MatchEvent[]
  teamStats MatchTeamStats[]
  lineups   MatchLineup[]
  players   MatchPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId])
  @@index([date])
  @@index([season])
  @@map("matches")
}

// -------------------------------------------------------------
// DETALLE DEL PARTIDO (estadísticas, alineaciones, jugadores)
// -------------------------------------------------------------

// Estadísticas de un equipo en un partido. `stats` usa claves propias (ver src/lib/match-stats.ts)
model MatchTeamStats {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stats   Json

  @@unique([matchId, teamId])
  @@map("match_team_stats")
}

model MatchLineup {
  id            String  @id @default(cuid())
  matchId       String
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  formation     String?
  coachName     String?
  coachPhotoUrl String?
  // Colores de la camiseta (hex sin #) para dibujar a los jugadores en la cancha
  shirtColor    String?
  numberColor   String?
  keeperColor   String?

  @@unique([matchId, teamId])
  @@map("match_lineups")
}

// Un jugador en un partido: alineación + estadísticas individuales
model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  number    Int?
  position  String? // G, D, M o F
  grid      String? // "fila:columna" en la cancha; solo titulares
  isStarter Boolean @default(false)
  isCaptain Boolean @default(false)
  minutes   Int?
  rating    Float? // nota de la API (0-10)
  stats     Json? // goles, asistencias, remates, pases... (ver src/lib/match-stats.ts)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("match_players")
}

// -------------------------------------------------------------
// EVENTOS DEL PARTIDO (LÍNEA DE TIEMPO)
// -------------------------------------------------------------
enum MatchEventType {
  GOAL
  PENALTY_GOAL
  OWN_GOAL
  MISSED_PENALTY
  YELLOW_CARD
  SECOND_YELLOW
  RED_CARD
  SUBSTITUTION
  VAR
}

model MatchEvent {
  id          String         @id @default(cuid())
  type        MatchEventType
  minute      Int
  extraMinute Int?
  sortOrder   Int

  // Goles: goleador. Tarjetas: jugador amonestado. Cambios: jugador que ENTRA.
  playerName        String?
  // Goles: asistente. Cambios: jugador que SALE.
  relatedPlayerName String?
  detail            String?

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Equipo al que se acredita el evento (en un gol en propia puerta, el equipo que anota)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([matchId, sortOrder])
  @@index([matchId])
  @@map("match_events")
}

// -------------------------------------------------------------
// RESEÑAS, CALIFICACIONES & VOTOS
// -------------------------------------------------------------
model Review {
  id          String   @id @default(cuid())
  rating      Float
  title       String?
  // Opcional: una reseña sin texto es solo una calificación
  content     String?  @db.Text
  hasSpoilers Boolean  @default(false)
  tags        String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  likes    ReviewLike[]
  comments ReviewComment[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  isLike    Boolean // true para Like, false para Dislike
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@map("review_likes")
}

model ReviewComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reports   Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  // Límite de frecuencia: comentarios recientes de un usuario
  @@index([userId, createdAt])
  @@map("review_comments")
}

// -------------------------------------------------------------
// MODERACIÓN
// -------------------------------------------------------------
enum ReportReason {
  SPAM
  OFFENSIVE
  UNMARKED_SPOILER
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
}

// Un reporte apunta a una reseña o a un comentario (exactamente uno de los dos).
// Si el contenido se elimina, sus reportes se van con él: no queda nada pendiente que revisar.
model Report {
  id      String       @id @default(cuid())
  reason  ReportReason
  details String?
  status  ReportStatus @default(PENDING)

  // Sin autor cuando lo crea el filtro automático de lenguaje
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  automatic  Boolean @default(false)

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  commentId String?
  comment   ReviewComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Cada usuario reporta una vez cada contenido (en Postgres los NULL no chocan entre sí)
  @@unique([reporterId, reviewId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model MvpVote {
  id       String @id @default(cuid())
  userId   String
  matchId  String
  playerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@map("mvp_votes")
}

// Partidos pendientes. "Visto" se deduce de tener al menos un MatchLog.
model Watchlist {
  id      String @id @default(cuid())
  userId  String
  matchId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@map("watchlist")
}

// -------------------------------------------------------------
// DIARIO (cada vez que el usuario ve un partido)
// -------------------------------------------------------------
enum WatchMethod {
  STADIUM
  TV
  STREAMING
  REPLAY
  HIGHLIGHTS
}

model MatchLog {
  id        String       @id @default(cuid())
  watchedOn DateTime     @db.Date
  method    WatchMethod?
  isRewatch Boolean      @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, watchedOn])
  @@index([matchId])
  @@map("match_logs")
}

// -------------------------------------------------------------
// TRAYECTORIA DEL JUGADOR (clubes y selecciones, según API-Football)
// -------------------------------------------------------------
model PlayerCareerTeam {
  id        String  @id @default(cuid())
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // El equipo puede no estar en nuestra base (ligas que no cargamos), por eso se guarda su id y nombre
  teamApiId Int
  teamName  String
  teamLogo  String?
  // Años de inicio de cada temporada (2024 = 2024-25), de la más reciente a la más antigua
  seasons   Int[]
  // Orden en que la API los devuelve (del más reciente al más antiguo)
  sortOrder Int

  @@unique([playerId, teamApiId])
  @@map("player_career_teams")
}
